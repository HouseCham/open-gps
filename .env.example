ENV=
# =============================================================================
# open-gps — Environment variables
# =============================================================================
# This file is consumed by docker-compose via the COMPOSE_FILE variable
# defined in the .env file at the repo root, or by Dokploy's Environment
# Variables UI.
#
# LOCAL DEV (docker-compose.local.yml):
#   - Leave the values as-is below — `docker compose up` works straight away.
#   - The frontend and API share the same origin (https://localhost).
#
# PRODUCTION (Dokploy):
#   - Override every value marked [DOKPLOY] with the real public domain.
#   - Inject secrets via Dokploy's Environment Variables UI, not by
#     committing a populated .env.
# =============================================================================

# ---- Postgres (db service) ----
POSTGRES_USER=opengps
POSTGRES_PASSWORD=opengps_pass
POSTGRES_DB=opengps

# ---- API (api service, internal-only) ----
# Port the Go binary listens on. Must match nginx's proxy_pass upstream.
API_PORT=8080

# CORS — local: empty (same-origin via nginx). [DOKPLOY] set to the public domain.
CORS_ALLOWED_ORIGINS=

# ---- Authula (embedded in the api service) ----
# Base URL must match the public origin. Authula uses it to build OAuth
# redirect URIs and email links.
AUTHULA_BASE_URL=https://localhost
AUTHULA_SECRET=replace-with-openssl-rand-hex-32

# ---- Google OAuth (optional) ----
# Leave empty to disable Google login; everything else still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- JWT validation (api validates tokens issued by Authula) ----
# Authula exposes JWKS at <AUTHULA_BASE_URL>/api/auth/.well-known/jwks.json
JWT_JWKS_URL=https://localhost/api/auth/.well-known/jwks.json
JWT_ISSUER=https://localhost
JWT_AUDIENCE=open-gps-api

# ---- Nginx ----
# Upstream for the API. Defaults to api:8080 inside the compose network.
NGINX_API_UPSTREAM=api:8080

# ---- Resend SDK ----
RESEND_API_KEY=
WELCOME_EMAIL_TEMPLATE_EN_ID=
WELCOME_EMAIL_TEMPLATE_ES_ID=
PASSWORD_RESET_EMAIL_TEMPLATE_EN_ID=
PASSWORD_RESET_EMAIL_TEMPLATE_ES_ID=
EMAIL_FROM="Open GPS <info@example.com>"
WELCOME_PASSWORD_RESET_TEMPLATE_EN_ID=
WELCOME_PASSWORD_RESET_TEMPLATE_ES_ID=

# ---- Frontend ----
# Baked into the bundle at build time as `--build-arg PUBLIC_API_URL=...`.
# Leave empty for the same-origin setup (frontend calls /api/v1/* directly).
PUBLIC_API_URL=

# =============================================================================
# [DOKPLOY] production overrides — apply these in Dokploy's Environment UI:
# =============================================================================
# AUTHULA_BASE_URL=https://<your-subdomain>.dokploy.io
# JWT_JWKS_URL=https://<your-subdomain>.dokploy.io/api/auth/.well-known/jwks.json
# JWT_ISSUER=https://<your-subdomain>.dokploy.io
# CORS_ALLOWED_ORIGINS=https://<your-subdomain>.dokploy.io
# AUTHULA_SECRET=<openssl rand -hex 32>
# POSTGRES_PASSWORD=<strong random>
# GOOGLE_CLIENT_ID=<from Google Cloud Console>
# GOOGLE_CLIENT_SECRET=<from Google Cloud Console>