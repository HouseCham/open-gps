---
import '@/styles/global.css';
import '@/styles/layout/main-layout.css';
//-- i18n
import { getTranslation } from '@/i18n';
//-- Types
import type { Language } from '@/types';
//-- Components
import {
    AuthProvider,
    PublicOnlyRoute
} from '@/components/react/auth';
import { ToastProvider } from '@/components/react/ui';
import { ThemeToggle } from '@/components/react/ui/ThemeToggle';
import { MapSVG, RecoveryPipelineSVG } from '@/components/react';

/**
 * Brand-panel variants. `default` keeps the fleet-route visual used by
 * login + signup; `recovery` swaps in the 4-hop pipeline visual + the
 * "recover access" copy for the password-recovery pages.
 * @typedef {'default' | 'recovery'} AuthLayoutVariant
 */
export type AuthLayoutVariant = 'default' | 'recovery';

/**
 * @interface Props
 * @property {Language} [locale='en'] - Current locale code.
 * @property {string | undefined} [title] - Page title.
 * @property {string | undefined} [class] - Extra classes.
 * @property {boolean} [isLoginPage] - Marks the login page so PublicOnlyRoute can redirect.
 * @property {AuthLayoutVariant} [variant='default'] - Brand-panel variant.
 */
interface Props {
    locale?: Language;
    title?: string;
    class?: string;
    isLoginPage?: boolean;
    variant?: AuthLayoutVariant;
}

const {
    locale = 'en',
    title = 'Open GPS',
    class: className,
    isLoginPage,
    variant = 'default',
} = Astro.props;
const t = getTranslation(locale);
const classes = ['auth-layout', `auth-layout--${variant}`, className]
    .filter(Boolean)
    .join(' ');
const isRecovery = variant === 'recovery';
const brand = isRecovery
    ? {
          tagline: t.auth.recoveryBrand.tagline,
          taglineAccent: t.auth.recoveryBrand.taglineAccent,
          subtitle: t.auth.recoveryBrand.subtitle,
          svgStatus: t.auth.recoveryBrand.svgStatus,
          svgTtl: t.auth.recoveryBrand.svgTtl,
          footerSection: t.auth.recoveryBrand.footerSection,
          step1: t.auth.recoveryBrand.step1,
          step2: t.auth.recoveryBrand.step2,
          step3: t.auth.recoveryBrand.step3,
      }
    : {
          tagline: t.auth.tagline,
          taglineAccent: t.auth.taglineAccent,
          subtitle: t.auth.brandSubtitle,
          svgStatus: t.auth.svgStatus,
          svgTtl: t.auth.svgStatus,
          footerSection: t.auth.footerTech,
          step1: '',
          step2: '',
          step3: '',
      };
---

<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={t.auth.metaDescription} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <script is:inline>
            // eslint-disable-next-line @typescript-eslint/explicit-function-return-type
            (function () {
                try {
                    var t = localStorage.getItem('open-gps:theme');
                    if (!t) {
                        t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                    }
                    document.documentElement.setAttribute('data-theme', t);
                } catch (err) {
                    void err;
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            })();
        </script>
    </head>
    <body>
        <ToastProvider client:idle />
        <AuthProvider
            client:idle
            showToast={false}
        >
            <PublicOnlyRoute
                client:load
                isLoginPage={isLoginPage}
                loadingMessage={t.auth.loading}
            >
                <div class={classes}>
                    <div class="auth-split">
                        <aside class="auth-brand">
                            <div class="brand-controls">
                                <ThemeToggle client:idle />
                            </div>

                            <div class="mark">
                                <span class="dot"></span>
                                <span class="name">{t.auth.appName}</span>
                                <span class="ver">{t.auth.version}</span>
                            </div>

                            <div>
                                <div class="tagline">
                                    {brand.tagline}<span class="accent">{brand.taglineAccent}</span>
                                </div>
                                <div class="sub">
                                    {brand.subtitle}
                                </div>
                            </div>

                            <div class="visual" aria-hidden="true">
                                {isRecovery ? (
                                    <RecoveryPipelineSVG
                                        client:visible
                                        status={brand.svgStatus}
                                        ttl={brand.svgTtl}
                                    />
                                ) : (
                                    <MapSVG
                                        client:visible
                                        status={brand.svgStatus}
                                    />
                                )}
                            </div>

                            {isRecovery && (
                                <div class="step-rail" aria-label="Step 1 of 3">
                                    <span class="dot active" aria-hidden="true"></span>
                                    <span class="lbl now">{brand.step1}</span>
                                    <span class="sep" aria-hidden="true"></span>
                                    <span class="dot" aria-hidden="true"></span>
                                    <span class="lbl">{brand.step2}</span>
                                    <span class="sep" aria-hidden="true"></span>
                                    <span class="dot" aria-hidden="true"></span>
                                    <span class="lbl">{brand.step3}</span>
                                </div>
                            )}

                            <div class="footer">
                                <span>{t.auth.footerHost}</span>
                                <span>{isRecovery ? brand.footerSection : t.auth.footerTech}</span>
                            </div>
                        </aside>

                        <div class="auth-form">
                            <slot />
                        </div>
                    </div>
                </div>
            </PublicOnlyRoute>
        </AuthProvider>
    </body>
</html>

<style>
    .auth-layout {
        display: flex;
        justify-content: center;
        min-height: 100vh;
        background: var(--gp-bg);
    }

    .auth-layout > .auth-split {
        flex: 1;
        max-width: 1200px;
        width: 100%;
        min-height: 100vh;
    }

    .auth-layout .auth-brand,
    .auth-layout .auth-form {
        min-height: 100%;
    }

    .auth-layout .brand-controls {
        position: absolute;
        top: var(--s-3);
        right: var(--s-4);
    }

    .auth-layout .sub {
        margin-top: 0.625rem;
    }

    @media (max-width: var(--bp-tablet)) {
        .auth-layout > .auth-split {
            min-height: auto;
        }
    }
</style>

