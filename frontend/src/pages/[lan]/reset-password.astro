---
//-- i18n
import { getTranslation } from '@/i18n';
//-- Types
import type { GetStaticPaths } from 'astro';
import type { Language } from '@/types';
//-- Components
import AuthLayout from '@/components/astro/layout/AuthLayout.astro';
import { ResetPasswordForm } from '@/components/react/form/ResetPasswordForm';
//-- Utils
import { parseResetPasswordStrings } from '@/lib';

/**
 * @type {GetStaticPaths}
 */
export const getStaticPaths = (() => {
    return [{ params: { lan: 'en' } }, { params: { lan: 'es' } }];
}) satisfies GetStaticPaths;

const locale = Astro.params.lan as Language;
const translation = getTranslation(locale);
const resetStrings = parseResetPasswordStrings(translation.auth);
---

<AuthLayout
    isLoginPage
    locale={locale}
    variant="recovery"
    title={`${translation.auth.passwordRecovery.reset.title} · Open GPS`}
>
    <ResetPasswordForm client:load strings={resetStrings} locale={locale} />
</AuthLayout>
