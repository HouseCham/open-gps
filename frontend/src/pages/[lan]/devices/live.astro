---
import { getTranslation } from '@/i18n';
import type { GetStaticPaths } from 'astro';
import type { Language } from '@/types';
import MainLayout from '@/components/astro/layout/MainLayout.astro';

export const getStaticPaths: GetStaticPaths = () => [
    { params: { lan: 'en' } },
    { params: { lan: 'es' } },
];

const locale = Astro.params.lan as Language;
const translation = getTranslation(locale);
const title = `${translation.page.deviceDetail.title} · ${translation.layout.appName}`;
const deviceDetailPath = `/${locale}/devices/detail`;
---

<MainLayout
    locale={locale}
    title={title}
    pageLabel={translation.page.deviceDetail.title}
>
    <div
        id="device-detail-redirect"
        data-target={deviceDetailPath}
        hidden
    ></div>
    <p class="dd-loading" role="status" aria-live="polite">
        {translation.device.live.loading}
    </p>
    <a href={`${deviceDetailPath}?view=history`}>
        {translation.device.live.backToDevice}
    </a>
</MainLayout>

<script is:inline>
    const target = document.getElementById('device-detail-redirect')?.dataset.target;
    if (target) {
        const params = new URLSearchParams(window.location.search);
        params.set('view', 'history');
        const query = params.toString();
        window.location.replace(
            `${target}${query ? `?${query}` : ''}${window.location.hash}`
        );
    }
</script>
