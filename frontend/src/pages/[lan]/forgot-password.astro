---
import type { GetStaticPaths } from 'astro';
//-- Translations
import { getTranslation } from '@/i18n';
//-- types
import type { Language } from '@/types';
//-- Components
import AuthLayout from '@/components/astro/layout/AuthLayout.astro';
import { PasswordForgottenForm } from '@/components/react/form/PasswordForgottenForm';
//-- Utils
import { parsePasswordForgottenStrings } from '@/lib';

/**
 * @type {GetStaticPaths}
 */
export const getStaticPaths = (): ReturnType<GetStaticPaths> => {
    return [{ params: { lan: 'en' } }, { params: { lan: 'es' } }];
};

// getStaticPaths constrains lan to 'en' | 'es', so narrowing to Language is safe.
const locale = Astro.params.lan as Language;
const translation = getTranslation(locale);
const recoveryStrings = parsePasswordForgottenStrings(translation.auth);
---

<AuthLayout
    isLoginPage
    locale={locale}
    variant="recovery"
    title={`${translation.auth.passwordRecovery.title} · Open GPS`}
>
    <PasswordForgottenForm
        client:load
        strings={recoveryStrings}
        locale={locale}
    />
</AuthLayout>
